# Network Configuration
ROTATOR_HOST=127.0.0.1
ROTATOR_PORT=8888
UPSTREAM_URL=https://daily-cloudcode-pa.googleapis.com

# Quota Cooldown Duration (seconds)
COOLDOWN_SECONDS=1800
UPSTREAM_TIMEOUT=120

# Log Rotation (default: 5MB per file, 2 backups)
# ROTATOR_LOG_MAX_BYTES=5242880
# ROTATOR_LOG_BACKUP_COUNT=2

# Optional custom accounts database path (default: accounts.json in project root)
# ACCOUNTS_FILE=accounts.json

# Optional custom Antigravity IDE settings path
# IDE_SETTINGS_FILE=/Users/eleck/Library/Application Support/Antigravity IDE/User/settings.json

# Optional custom Google OAuth Client Credentials (defaults to built-in desktop clients)
# OAUTH_CLIENT_ID_1=your-client-id.apps.googleusercontent.com
# OAUTH_CLIENT_SECRET_1=your-client-secret
# OAUTH_CLIENT_ID_2=
# OAUTH_CLIENT_SECRET_2=

